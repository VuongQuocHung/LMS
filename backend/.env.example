# Sao chép thành .env cạnh pom.xml rồi điền thông tin PostgreSQL của bạn.
# Spring đọc theo định dạng Properties: KEY=value, không bọc giá trị bằng dấu nháy.
# Nếu mật khẩu chứa dấu gạch chéo ngược, viết hai dấu gạch chéo ngược để giữ nguyên.
DB_URL=jdbc:postgresql://localhost:5432/THAY_BANG_HOST_CUA_BAN
DB_USERNAME=THAY_BANG_USERNAME_CUA_BAN
DB_PASSWORD=THAY_BANG_MAT_KHAU_POSTGRES_CUA_BAN
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_COUNT=5
UPLOAD_MAX_REQUEST_SIZE=21MB
